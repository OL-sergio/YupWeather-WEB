<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>YupWeather</title>
		<script type="importmap">
			{
				"imports": {
					"animejs": "https://cdn.jsdelivr.net/npm/animejs@4.5.0/+esm"
				}
			}
		</script>
		<link rel="stylesheet" href="/css/style.css" />
	</head>
	<body>
		<main class="weather-app">
			<div class="search-container">
				<p class="forecast-data">
					Feels like:<span class="forecast-feels-like">
						<%= weather?.feelsLike %> °C</span
					>
				</p>

				<p class="forecast-data">
					Humidity:<span class="forecast-humidity"
						><%= weather?.humidity %> %</span
					>
				</p>
				<p class="forecast-data">
					Wind:<span class="forecast-wind"><%= weather?.wind %> m/s</span>
				</p>
				<div class="divider-forecast"></div>
				<div class="forecast">
					<% if (forecast && forecast.list && forecast.list.length) { %> <%
					forecast.list.slice(0, 4).forEach((item) => { %>
					<div class="forecast-day">
						<% if (item.weather[0]?.icon) { %>
						<img
							class="forecast-icon"
							src="https://openweathermap.org/img/wn/<%= item.weather[0].icon %>@2x.png"
							alt="<%= item.weather[0].description || 'Weather icon' %>"
						/>
						<p class="forecast-dt"><%= item.dt %></p>
						<% }; %>
						<p class="forecast-temperature"><%= item.temp %> °C</p>
					</div>
					<% }); %> <% }; %>
				</div>

				<form action="/" method="get" class="search-form">
					<button
						class="search-information"
						type="button"
						aria-expanded="false"
						aria-controls="search-row"
					>
						<img class="location-icon" src="/images/pin.png" />
						Change Location
					</button>
					<div class="search-row" id="search-row" hidden>
						<input
							id="city"
							name="city"
							value="<%= city || '' %>"
							placeholder="e.g. Lisbon"
							required
						/>
						<button class="search-button" type="submit">Search</button>
					</div>
				</form>
			</div>
			<div class="background-weather background-image">
				<% if (error) { %>
				<p class="message error" role="alert"><%= error %></p>
				<% } else if (weather) { %>
				<section class="weather-card" aria-live="polite">
					<p class="day"><%= weather.day %></p>
					<p class="date"><%= weather.date %></p>
					<p class="location">
						<img class="location-icon" src="/images/pin.png" alt="" />
						<%=weather.city %> <% if (weather.country) { %> , <%=weather.country
						%> <% } %>
					</p>

					<div class="divider"></div>
					<% if (weather.icon && weather.icon !== 'Unavailable') { %>
					<img
						class="icon"
						src="https://openweathermap.org/img/wn/<%= weather.icon %>@2x.png"
						alt="<%= weather.description %>"
					/>
					<% } %>
					<p class="temperature"><%= weather.temperature %> °C</p>
					<p class="condition" alt="Weather condition">
						<%= weather.description %>
					</p>
				</section>
				<% } else { %>
				<p class="message">Enter a city to see the current weather.</p>
				<% } %>
			</div>
		</main>
		<script src="/js/cliente.js"></script>
		<script type="module" src="/js/anime.js"></script>
	</body>
</html>
