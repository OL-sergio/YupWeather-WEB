<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>YupWeather</title>
		<link rel="stylesheet" href="/css/style.css" />
	</head>
	<body>
		<main class="weather-app">
			<div class="search-container">
				<p class="prediction">prediction</p>
				<p class="humidity"></p>
				<p class="wind">wind</p>

				<div class="forecast">
					<div class="forecast-day">
						<p class="day">day</p>
						<image class="icon" src="" alt="Weather icon" />
						<p class="temperature">temperature</p>
					</div>
				</div>

				<form action="/" method="get" class="search-form">
					<label for="city">Search by city</label>
					<div class="search-row">
						<input
							id="city"
							name="city"
							value="<%= city || '' %>"
							placeholder="e.g. Lisbon"
							required
						/>
						<button type="submit">Search</button>
					</div>
				</form>
			</div>
			<div class="background-weather background-image">
				<% if (error) { %>
				<p class="message error" role="alert"><%= error %></p>
				<% } else if (weather) { %>
				<section class="weather-card" aria-live="polite">
					<p class="day"><%= weather.day %></p>
					<p class="date"><%= weather.date %></p>
					<p class="location">
						<%= weather.city %> <% if (weather.country) { %> <%=weather.country
						%> <% } %>
					</p>

					<% if (weather.icon && weather.icon !== 'Unavailable') { %>
					<img
						class="icon"
						src="https://openweathermap.org/img/wn/<%= weather.icon %>@2x.png"
						alt="<%= weather.description %>"
					/>
					<% } %>
					<p class="temperature"><%= weather.temperature %>°C</p>
					<p class="condition" alt="Weather condition">
						<%= weather.description %>
					</p>
				</section>
				<% } else { %>
				<p class="message">Enter a city to see the current weather.</p>
				<% } %>
			</div>
		</main>
	</body>
</html>
