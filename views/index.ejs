<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>YupWeather</title>
		<link rel="stylesheet" href="/css/style.css" />
	</head>
	<body>
		<main class="weather-app">
			<div class="search-container">
				<p class="forecast-data">Feels like: <%= weather?.feelsLike %> C</p>
				<p class="forecast-data">Humidity: <%= weather?.humidity %>%</p>
				<p class="forecast-data">Wind: <%= weather?.wind %> m/s</p>

				<div class="forecast">
					<% if (forecast && forecast.list && forecast.list.length) { %> <%
					forecast.list.slice(0, 4).forEach((item) => { %>
					<div class="forecast-day">
						<% if (item.weather[0]?.icon) { %>
						<img
							class="forecast-icon"
							src="https://openweathermap.org/img/wn/<%= item.weather[0].icon %>@2x.png"
							alt="<%= item.weather[0].description || 'Weather icon' %>"
						/>
						<p class="forecastdt"><%= item.dt %></p>
						<% } %>
						<p class="forecastTemperature"><%= item.temp %>°C</p>
					</div>
					<% }) %> <% } %>
				</div>

				<form action="/" method="get" class="search-form">
					
					<p />
					<div class="search-row">
						<input
							id="city"
							name="city"
							value="<%= city || '' %>"
							placeholder="e.g. Lisbon"
							required
						/>
						<button type="submit">Search</button>
					</div>
				</form>
			</div>
			<div class="background-weather background-image">
				<% if (error) { %>
				<p class="message error" role="alert"><%= error %></p>
				<% } else if (weather) { %>
				<section class="weather-card" aria-live="polite">
					<p class="day"><%= weather.day %></p>
					<p class="date"><%= weather.date %></p>
					<p class="location">
						<img class="location-icon" src="/images/pin.png" alt="" />
						<%=weather.city %> <% if (weather.country) { %> , <%=weather.country
						%> <% } %>
					</p>

					<div class="divider"></div>
					<% if (weather.icon && weather.icon !== 'Unavailable') { %>
					<img
						class="icon"
						src="https://openweathermap.org/img/wn/<%= weather.icon %>@2x.png"
						alt="<%= weather.description %>"
					/>
					<% } %>
					<p class="temperature"><%= weather.temperature %>°C</p>
					<p class="condition" alt="Weather condition">
						<%= weather.description %>
					</p>
				</section>
				<% } else { %>
				<p class="message">Enter a city to see the current weather.</p>
				<% } %>
			</div>
		</main>
	</body>
</html>
